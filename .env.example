# BidGuard 运行环境变量模板（可选，复制为 .env 使用；也可直接在界面 ⌘, 中配置并持久化至 SQLite）

# 服务监听端口（默认 8000）
PORT=8000

# 运行时数据目录（默认 ./data）
# BIDGUARD_DATA_DIR=./data

# 预注入供应商 API Key（仅首次初始化数据库时读取，后续以界面设置为准）
# DASHSCOPE_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# ARK_API_KEY=...
# SILICONFLOW_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
